# InfinityFree production .env TEMPLATE
# ---------------------------------------------------------------
# Fill these in AFTER you create the MySQL database in vPanel
# (InfinityFree → vPanel → MySQL Databases), then:
#   1. Rename/copy this file to ".env"  (no extension before .env)
#   2. Upload it to the project ROOT on the server (htdocs/.env)
#      -- or paste these lines into a new htdocs/.env via File Manager.
#
# admin/functions.php -> envv() reads a root .env BEFORE any fallback,
# so this is all that's needed to point the live site at InfinityFree's DB.
#
# Values come from vPanel → MySQL Databases:
#   DB_HOST  -> the "sqlXXX.infinityfree.com" host shown there (NOT localhost)
#   DB_NAME  -> the database you created, e.g. if0_xxxxxxxx_kltg
#   DB_USER  -> your account ID, e.g. if0_xxxxxxxx
#   DB_PASS  -> your vPanel password
# ---------------------------------------------------------------

DB_HOST=sqlXXX.infinityfree.com
DB_USER=if0_xxxxxxxx
DB_PASS=your_vpanel_password
DB_NAME=if0_xxxxxxxx_kltg
